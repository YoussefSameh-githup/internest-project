# Copy this file to `.env` at the project root, then fill in real values.
# `.env` is in .gitignore — never commit it.
#
# Both the WSGI app and `python manage.py shell` read from this file via
# django-environ. The web app no longer needs os.environ['...'] lines in
# the PythonAnywhere WSGI file for these variables.

# --- Django core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=youssefsameh.pythonanywhere.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://youssefsameh.pythonanywhere.com
DJANGO_SECURE_SSL_REDIRECT=False

# --- Email (Gmail SMTP; password must be a Gmail App Password) ---
EMAIL_HOST_USER=internest.opportunities@gmail.com
EMAIL_HOST_PASSWORD=replace-with-16-char-app-password

# --- Skill extraction LLM (optional; falls back to local keyword matcher) ---
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Gemini instead: AGENTROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model is auto-picked (gemini-2.5-flash for googleapis.com, else gpt-4o-mini); set to override.
SKILLS_LLM_MODEL=
# Failover key: used automatically when the primary key hits a quota/rate limit, timeout or HTTP error.
# (API_KEY_1 / API_BASE_URL_1 may be used instead of the AGENTROUTER_* names above.)
API_KEY_2=
# Optional: another provider for the backup, e.g. Groq https://api.groq.com/openai/v1 (empty = same as primary)
API_BASE_URL_2=
API_MODEL_2=
# Direct Google Gemini (recommended; free key at https://aistudio.google.com/apikey). Tried FIRST.
# Works from PythonAnywhere free accounts. Use a current model: gemini-2.5-flash (1.5 models are retired).
GEMINI_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
# Azure OpenAI / Copilot (4th in the chain). Endpoint = v1 API, model = your deployment name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AI failover order: GEMINI_API_KEY -> API_KEY_1 (AgentRouter) -> API_KEY_2 -> AZURE_OPENAI -> saved question bank.
# Check every key live:  python manage.py test_ai_connection --skill Cybersecurity
# Voice-to-CV (Whisper). Empty = reuse a Groq/OpenAI key above. Groq: https://api.groq.com/openai/v1
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3
# Leave False on PythonAnywhere free accounts (outbound traffic must use the platform proxy).
ENABLE_PROXY_BYPASS=False
# Freelance importer: False = admin approves each gig before its skills are verified (recommended).
FREELANCE_AUTO_VERIFY=False

# --- Payments (Fawaterak, EGP) & public contact ---
FAWATERAK_API_KEY=
FAWATERAK_BASE_URL=https://app.fawaterk.com
SUPPORT_PHONE=01113999387
SUPPORT_EMAIL=engineerthe973@gmail.com
