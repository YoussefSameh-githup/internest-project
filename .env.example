# Copy this file to `.env` at the project root, then fill in real values.
# `.env` is in .gitignore — never commit it.
#
# Both the WSGI app and `python manage.py shell` read from this file via
# django-environ. The web app no longer needs os.environ['...'] lines in
# the PythonAnywhere WSGI file for these variables.

# --- Django core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=youssefsameh.pythonanywhere.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://youssefsameh.pythonanywhere.com
DJANGO_SECURE_SSL_REDIRECT=False

# --- Database & cache (optional) ---
# Default: SQLite at <project>/db.sqlite3. SQLITE_PATH moves it (the load benchmark uses a disposable copy).
# DATABASE_URL switches to PostgreSQL, e.g. postgres://user:pass@127.0.0.1:5432/internest
# REDIS_URL replaces the file cache, e.g. redis://127.0.0.1:6379/0
# Leave these commented out unless you use them (an empty SQLITE_PATH= would point SQLite at an empty path).
# SQLITE_PATH=/home/you/internest-data/db.sqlite3
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/internest
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Email (Gmail SMTP; password must be a Gmail App Password) ---
EMAIL_HOST_USER=internest.opportunities@gmail.com
EMAIL_HOST_PASSWORD=replace-with-16-char-app-password

# --- Skill extraction LLM (optional; falls back to local keyword matcher) ---
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Gemini instead: AGENTROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model is auto-picked (gemini-2.5-flash for googleapis.com, else gpt-4o-mini); set to override.
SKILLS_LLM_MODEL=
# Failover key: used automatically when the primary key hits a quota/rate limit, timeout or HTTP error.
# (API_KEY_1 / API_BASE_URL_1 may be used instead of the AGENTROUTER_* names above.)
API_KEY_2=
# Optional: another provider for the backup, e.g. Groq https://api.groq.com/openai/v1 (empty = same as primary)
API_BASE_URL_2=
API_MODEL_2=
# Direct Google Gemini (recommended; free key at https://aistudio.google.com/apikey). Tried FIRST.
# Works from PythonAnywhere free accounts. Use a current model: gemini-2.5-flash (1.5 models are retired).
GEMINI_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
# Azure OpenAI / Copilot (4th in the chain). Endpoint = v1 API, model = your deployment name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Default AI order (internest_ai/router.py): local model -> free providers (Gemini, Groq, OpenRouter, Cloudflare)
# -> paid (API_KEY_1 AgentRouter, API_KEY_2, Azure OpenAI) -> saved question bank / keyword matching.
# Check every key live:  python manage.py test_ai_connection --skill Cybersecurity

# --- AI engine (internest_ai): extra providers, enabled only when set ---
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
# OpenRouter (empty model = a free ":free" model): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Cloudflare Workers AI (both needed): https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=
# Local Ollama / llama.cpp server (OpenAI-compatible, no key; private data never leaves the server).
# e.g. AI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1  AI_LOCAL_MODEL=qwen2.5:7b-instruct
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=
AI_LOCAL_LONG_CONTEXT=False
# Explicit provider order (registry keys, comma-separated; only these are used). Empty = local, free, then paid.
# Keys: local_llm, gemini, groq, openrouter, cloudflare_ai, agentrouter, backup_llm, azure_openai
AI_PROVIDER_ORDER=
# Deterministic mock provider (tests / load benchmarks). Ignored when DJANGO_DEBUG=False unless AI_MOCK_ALLOW_PRODUCTION=True.
AI_MOCK_PROVIDER=False
AI_MOCK_ALLOW_PRODUCTION=False
AI_MOCK_LATENCY_MS=0
# Circuit breaker: open after N consecutive failures within the window, skip the provider for OPEN seconds, then probe once.
AI_BREAKER_ENABLED=True
AI_BREAKER_FAILURES=3
AI_BREAKER_WINDOW_SECONDS=60
AI_BREAKER_OPEN_SECONDS=60
AI_BREAKER_MAX_RETRY_AFTER=900
# Quotas (0 = unlimited). Per-task overrides of the per-user daily cap, e.g. AI_QUOTA_TASK_LIMITS=cv_polish=20,cv_voice=10
AI_QUOTAS_ENABLED=True
AI_QUOTA_USER_DAILY=200
AI_QUOTA_TASK_LIMITS=
AI_QUOTA_PARTNER_DAILY=2000
AI_QUOTA_GLOBAL_PER_MINUTE=300
AI_QUOTA_GLOBAL_PER_DAY=20000
AI_USAGE_RETENTION_DAYS=90
# Identical AI prompts are answered from the cache for this many seconds (0 = off).
AI_CACHE_TTL=604800

# --- Async AI tasks (internest_core/async_tasks.py) ---
# sync (PythonAnywhere default) | thread | db (+ `manage.py run_async_tasks` worker; the Azure VM uses this) | celery
ASYNC_TASK_BACKEND=
ASYNC_TASK_WORKERS=4
ASYNC_TASK_QUEUE_TIMEOUT=120
ASYNC_TASK_RUN_TIMEOUT=300
ASYNC_TASK_LEASE_SECONDS=300
ASYNC_TASK_MAX_ATTEMPTS=3
ASYNC_TASK_RETRY_BASE_SECONDS=5
ASYNC_TASK_RETRY_MAX_SECONDS=300
# Admission control: active tasks per user (429 + Retry-After) and queued tasks site-wide (503 + Retry-After).
ASYNC_TASK_USER_MAX_ACTIVE=2
ASYNC_TASK_USER_RETRY_AFTER=10
ASYNC_TASK_MAX_QUEUED=500
ASYNC_TASK_BACKPRESSURE_RETRY_AFTER=30

# Voice-to-CV (Whisper). Empty = reuse a Groq/OpenAI key above. Groq: https://api.groq.com/openai/v1
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3
# Leave False on PythonAnywhere free accounts (outbound traffic must use the platform proxy).
ENABLE_PROXY_BYPASS=False
# Freelance importer: False = admin approves each gig before its skills are verified (recommended).
FREELANCE_AUTO_VERIFY=False

# --- Payments (Fawaterak, EGP) & public contact ---
FAWATERAK_API_KEY=
FAWATERAK_BASE_URL=https://app.fawaterk.com
SUPPORT_PHONE=01113999387
SUPPORT_EMAIL=engineerthe973@gmail.com

# --- Social login (leave a pair empty to hide that provider's button) ---------------------------------
# Callback URLs to register (replace the domain): https://YOUR-DOMAIN/oauth/<provider>/login/callback/
#   google          -> /oauth/google/login/callback/
#   linkedin_oauth2 -> /oauth/linkedin_oauth2/login/callback/
#   github          -> /oauth/github/login/callback/
#   microsoft       -> /oauth/microsoft/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common   # "common" = university/work/school AND personal Microsoft accounts

# --- Sentry error monitoring (optional; off while SENTRY_DSN is empty) ---
# Sentry > Project settings > Client Keys (DSN). Check with: python manage.py sentry_test
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Sends inline (no background thread). Defaults to on for PythonAnywhere, where web apps cannot run threads.
# SENTRY_SYNC_TRANSPORT=True
